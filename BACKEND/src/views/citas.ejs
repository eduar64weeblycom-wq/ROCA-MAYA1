<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Citas Médicas - Roca Maya</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styleCitas.css" />
  <style>
    .ctmodal-cita { display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); align-items:center; justify-content:center; z-index:1000; }
    .ctmodal-contenido { background:#fff; padding:20px; border-radius:10px; width:95%; max-width:700px; max-height:90vh; overflow:auto; }
    .info-small { font-size:0.9rem; color:var(--color-text-light, #6c757d); }
    .search-input { width:100%; padding:.375rem .75rem; border:1px solid #ced4da; border-radius:.25rem; margin-bottom:.5rem; }
    .filters-row { display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; }
    .ctfiltro-item { min-width:200px; flex:1; }
  </style>
</head>
<body>
  <main class="ctcontainer ctmy-4">
    <div class="ctcitas-header">
      <div class="header-left">
        <div class="logo-container">
          <button class="logo-btn" id="logoBtn" title="Volver al Dashboard" aria-label="Volver al Dashboard">
            <img src="/roca-maya-oct.jpg" alt="Clínicas Roca Maya" class="logo">
          </button>
          <div class="clinic-name">Clínicas Roca Maya</div>
        </div>

        <div class="title-wrap">
          <h1><i class="fas fa-calendar-check"></i> Gestión de Citas Médicas</h1>
          <p>Administra y programa las citas de los pacientes</p>
        </div>
      </div>

      <div class="actions-right">
        <button id="btnImprimir" class="btn btn-outline-secondary me-2" type="button" title="Imprimir listado de citas">
          <i class="fas fa-print"></i> Imprimir
        </button>

        <button id="btnNuevaCitaHeader" class="ctbtn-primary" type="button"><i class="fas fa-plus"></i> Nueva Cita</button>
      </div>
    </div>

    <div id="alertSuccess" class="ctalert ctalert-success" style="display:none;">
      <i class="fas fa-check-circle"></i> <span id="successMessage"></span>
    </div>
    <div id="alertError" class="ctalert ctalert-error" style="display:none;">
      <i class="fas fa-exclamation-circle"></i> <span id="errorMessage"></span>
    </div>

    <div class="ctfiltros-citas">
      <div class="filters-row">
        <div class="ctfiltro-item">
          <label for="searchGlobal">Buscar (paciente, doctor, teléfono, identidad, fecha...):</label>
          <input id="searchGlobal" class="search-input" type="search" placeholder="Buscar por nombre, teléfono, identidad, doctor, especialidad o fecha..." aria-label="Buscar todo" />
        </div>

        <div class="ctfiltro-item">
          <label for="filtroEstado">Filtrar por Estado:</label>
          <select id="filtroEstado" class="ctinput-field">
            <option value="">Todos los estados</option>
            <option value="PROGRAMADA">Programada</option>
            <option value="CONFIRMADA">Confirmada</option>
            <option value="FINALIZADA">Finalizada</option>
            <option value="CANCELADA">Cancelada</option>
            <option value="NO_ASISTIO">No Asistió</option>
          </select>
        </div>

        <!-- REMOVED: filtroPaciente -->

        <div class="ctfiltro-item">
          <label for="filtroDoctor">Filtrar por Doctor:</label>
          <select id="filtroDoctor" class="ctinput-field">
            <option value="">Todos los doctores</option>
          </select>
        </div>

        <div class="ctfiltro-item">
          <label for="filtroFecha">Filtrar por Fecha:</label>
          <input id="filtroFecha" type="date" class="ctinput-field" />
        </div>
      </div>
    </div>

    <div class="cttabla-citas">
      <div id="tablaContenido">
        <div class="ctsin-citas">
          <i class="fas fa-calendar-times"></i>
          <h3>No hay citas programadas</h3>
          <p>Comienza creando una nueva cita médica.</p>
          <button class="ctbtn-primary" id="btnCrearPrimera"><i class="fas fa-plus"></i> Crear Primera Cita</button>
        </div>
      </div>
    </div>
  </main>

  <!-- Modal Nueva Cita -->
  <div id="modalNuevaCita" class="ctmodal-cita" aria-hidden="true">
    <div class="ctmodal-contenido">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="fas fa-plus"></i> Nueva Cita</h4>
        <button type="button" class="ctclose-modal" id="btnCloseModal" aria-label="Cerrar">&times;</button>
      </div>

      <div id="modalError" class="ctalert ctalert-error" style="display:none; margin-bottom:10px;">
        <i class="fas fa-exclamation-circle"></i> <span id="modalErrorMessage"></span>
      </div>

      <form id="formNuevaCita" class="ctform">
        <div class="mb-3">
          <label>Paciente *</label>
          <input id="searchPaciente" class="search-input" type="search" placeholder="Buscar paciente por nombre, teléfono o identidad..." aria-label="Buscar paciente" />
          <select id="selectPaciente" class="ctinput-field" required>
            <option value="">Cargando pacientes...</option>
          </select>
          <div id="pacienteInfo" class="info-small mt-1"></div>
        </div>

        <div class="mb-3">
          <label>Doctor *</label>
          <input id="searchDoctor" class="search-input" type="search" placeholder="Buscar doctor por nombre, especialidad o identidad..." aria-label="Buscar doctor" />
          <select id="selectDoctor" class="ctinput-field" required>
            <option value="">Cargando doctores...</option>
          </select>
          <div id="doctorInfo" class="info-small mt-1"></div>
        </div>

        <div class="row mb-3">
          <div class="col-md-5">
            <label>Fecha *</label>
            <input id="inputFecha" type="date" class="ctinput-field" required />
          </div>
          <div class="col-md-4">
            <label>Hora *</label>
            <input id="inputHora" type="time" class="ctinput-field" required />
          </div>
          <div class="col-md-3">
            <label>Duración (min)</label>
            <select id="selectDuracion" class="ctinput-field">
              <option value="15">15</option>
              <option value="20">20</option>
              <option value="30" selected>30</option>
              <option value="45">45</option>
              <option value="60">60</option>
            </select>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <label>Tipo de Cita</label>
            <select id="selectTipoCita" class="ctinput-field"></select>
          </div>
          <div class="col-md-6">
            <label>Prioridad</label>
            <select id="selectPrioridad" class="ctinput-field"></select>
          </div>
        </div>

        <div class="mb-3">
          <label>Canal</label>
          <select id="selectCanal" class="ctinput-field"></select>
        </div>

        <div class="mb-3">
          <label>Motivo</label>
          <textarea id="textareaMotivo" class="ctinput-field" rows="3"></textarea>
        </div>

        <div class="mb-2 info-small">Hora estimada fin: <strong id="finEstimado">-</strong></div>

        <div class="d-flex justify-content-end gap-2">
          <button type="button" class="ctbtn-secondary" id="btnCancelarModal">CERRAR</button>
          <button type="button" class="ctbtn-primary" id="btnGuardarCita">CONFIRMAR CITA</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/citas.js" defer></script>
</body>
</html>