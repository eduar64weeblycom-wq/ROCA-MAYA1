<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle Recibo #<%= recibo.NUMERO_RECIBO %></title> 
    <link rel="stylesheet" href="/css/recibo.css"> <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script src="/js/recibos.js"></script> </head>
<body>
    <div class="container">
        
        <div class="header">
            <div class="logo-container">
                <button class="logo-btn" id="logoBtn" title="Volver al Listado de Recibos">
                    <img src="/roca-maya-oct.jpg" alt="Clínicas Roca Maya" class="logo">
                </button>
                <div class="clinic-name">Clínicas Roca Maya</div>
            </div>
        </div>

        <div class="main-content">
            
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>

            <div class="page-header">
                <h1>Detalle de Recibo #<%= recibo.NUMERO_RECIBO %></h1> 
                <div class="actions">
                    
                    <% if (recibo.ESTADO_RECIBO === 'PENDIENTE') { %>
                        <form action="/recibos/status/<%= recibo.ID_RECIBO %>?_method=PUT" method="POST" 
                              onsubmit="return confirm('¿Confirma que se ha recibido el pago por <%= parseFloat(recibo.MONTO_TOTAL).toFixed(2) %> L.?');" 
                              style="display: inline-block;">
                            <input type="hidden" name="newStatus" value="PAGADA">
                            <input type="hidden" name="original_query" value="detail"> 
                            <button type="submit" class="btn btn-success" title="Marcar como Pagado">
                                <i class="fas fa-wallet"></i> Pagar
                            </button>
                        </form>
                    <% } %>
                    
                    <% if (recibo.ESTADO_RECIBO === 'PENDIENTE') { %>
                        <form action="/recibos/status/<%= recibo.ID_RECIBO %>?_method=PUT" method="POST" 
                              onsubmit="return confirm('¿Está seguro de ANULAR el recibo #<%= recibo.NUMERO_RECIBO %>?');" 
                              style="display: inline-block; margin-left: 10px;">
                            <input type="hidden" name="newStatus" value="ANULADA">
                            <input type="hidden" name="original_query" value="detail"> 
                            <button type="submit" class="btn btn-danger" title="Anular Recibo">
                                <i class="fas fa-times-circle"></i> Anular
                            </button>
                        </form>
                    <% } %>
                    
                    <button class="btn btn-secondary" id="btnImprimirRecibo" style="margin-left: 10px;"> <i class="fas fa-print"></i> Imprimir</button>
                </div>
            </div>

            <div class="detail-grid">
                <div class="detail-card">
                    <h2>Información del Recibo</h2>
                    <p><strong>Número:</strong> <%= recibo.NUMERO_RECIBO || recibo.ID_RECIBO %></p>
                    <p><strong>Fecha Emisión:</strong> <%= new Date(recibo.FECHA_EMISION).toLocaleDateString('es-HN') %></p>
                    <p><strong>Estado:</strong> 
                        <span class="estado-tag estado-<%= recibo.ESTADO_RECIBO.toLowerCase() %>"> 
                            <%= recibo.ESTADO_RECIBO %> 
                        </span>
                    </p>
                    <% if (recibo.FECHA_PAGO) { %>
                        <p><strong>Fecha de Pago:</strong> <%= new Date(recibo.FECHA_PAGO).toLocaleString('es-HN') %></p>
                    <% } %>
                </div>
                
                <div class="detail-card">
                    <h2>Información del Cliente</h2>
                    <p><strong>Paciente:</strong> <%= recibo.NOMBRE_PACIENTE %></p>
                    <p><strong>RTN:</strong> <%= recibo.RTN_PACIENTE || 'N/A' %></p>
                    <p><strong>Cita Médica ID:</strong> <%= recibo.ID_CITA || 'N/A' %></p>
                </div>
            </div>
            
            <div class="section-title" style="margin-top: 25px;">Servicios Facturados</div>
            <table class="data-table detail-table">
                <thead>
                    <tr>
                        <th>Servicio</th>
                        <th>Precio Unitario</th>
                        <th>Cantidad</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recibo.DETALLES && recibo.DETALLES.length > 0) { %>
                        <% recibo.DETALLES.forEach(detalle => { %>
                            <tr>
                                <td><%= detalle.NOMBRE_SERVICIO %></td>
                                <td><%= parseFloat(detalle.PRECIO_UNITARIO).toFixed(2) %> L.</td>
                                <td><%= detalle.CANTIDAD %></td>
                                <td><%= parseFloat(detalle.TOTAL).toFixed(2) %> L.</td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align: center;">No se encontraron detalles de servicios para este recibo.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <div class="total-summary-wrapper" style="margin-top: 25px;">
                <div class="total-summary">
                    <div class="total-group">
                        <label>Subtotal:</label>
                        <input type="text" value="<%= parseFloat(recibo.SUBTOTAL).toFixed(2) %> L." readonly>
                    </div>
                    <div class="total-group">
                        <label>Descuento:</label>
                        <input type="text" value="<%= parseFloat(recibo.DESCUENTO).toFixed(2) %> L." readonly>
                    </div>
                    <div class="total-group">
                        <label>ISV (Impuesto 15%):</label>
                        <input type="text" value="<%= parseFloat(recibo.ISV).toFixed(2) %> L." readonly>
                    </div>
                    <div class="total-group">
                        <label>Saldo Pendiente:</label>
                        <input type="text" class="estado-tag estado-<%= recibo.ESTADO_RECIBO.toLowerCase() %>" value="<%= parseFloat(recibo.SALDO_PENDIENTE).toFixed(2) %> L." readonly>
                    </div>
                    <div class="total-group total-final">
                        <label>Monto Total:</label>
                        <input type="text" value="<%= parseFloat(recibo.MONTO_TOTAL).toFixed(2) %> L." readonly>
                    </div>
                </div>
            </div>
            
        </div>
        
        <div class="footer">
            Clínicas Roca Maya - Sistema de Gestión &copy; 2025
        </div>
    </div>
    
</body>
</html>