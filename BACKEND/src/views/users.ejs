<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuarios - Clínicas Roca Maya</title>
<link rel="icon" href="/ICONO.jpg" type="image/jpeg">

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/bitacora.css">
  <style>
    /* Estilos adicionales específicos para usuarios */
    .acciones-td {
      display: flex;
      gap: 8px;
      justify-content: center;
    }
    
    .btn-accion {
      padding: 6px 12px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
      transition: all 0.2s;
    }
    
    .btn-editar {
      background-color: #3498db;
      color: white;
    }
    
    .btn-editar:hover {
      background-color: #2980b9;
    }
    
    .btn-eliminar {
      background-color: #e74c3c;
      color: white;
    }
    
    .btn-eliminar:hover {
      background-color: #c0392b;
    }
    
    .btn-activar {
      background-color: #2ecc71;
      color: white;
    }
    
    .btn-activar:hover {
      background-color: #27ae60;
    }

    .btn-eliminar-permanente {
      background-color: #dc3545 !important;
      color: white;
    }

    .btn-eliminar-permanente:hover {
      background-color: #c82333 !important;
    }
    
    .estado-activo {
      background-color: #2ecc71;
      color: white;
      padding: 4px 8px;
      border-radius: 4px;
      font-weight: bold;
    }
    
    .estado-inactivo {
      background-color: #e74c3c;
      color: white;
      padding: 4px 8px;
      border-radius: 4px;
      font-weight: bold;
    }
    
    .fa-check {
      color: #2ecc71;
    }
    
    .fa-times {
      color: #e74c3c;
    }
    
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.5);
    }
    
    .modal-content {
      background-color: white;
      margin: 5% auto;
      padding: 20px;
      border-radius: 8px;
      width: 80%;
      max-width: 500px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }
    
    .form-group {
      margin-bottom: 15px;
    }
    
    .form-label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }
    
    .form-input {
      width: 100%;
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 4px;
      box-sizing: border-box;
    }
    
    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }
    
    .btn-cancelar {
      background-color: #95a5a6;
      color: white;
    }
    
    .btn-cancelar:hover {
      background-color: #7f8c8d;
    }
    
    .btn-disabled {
      background-color: #bdc3c7;
      color: #7f8c8d;
      cursor: not-allowed;
    }
    
    .btn-disabled:hover {
      background-color: #bdc3c7;
    }
  </style>
</head>

<body>

  <div class="container">
    <div class="header">
      <div class="logo-container">
        <button class="logo-btn" id="logoBtn" title="Volver al Dashboard">
          <img src="/roca-maya-oct.jpg" alt="Clínicas Roca Maya" class="logo">
        </button>
        <div class="clinic-name">Clínicas Roca Maya</div>
      </div>
    </div>

    <div class="main-content">
      <div class="page-header">
        <h1 class="page-title">Gestión de Usuarios</h1>
        <div class="actions">
          <!-- Botón deshabilitado para crear usuarios -->
          <button class="btn btn-disabled" id="btnNuevoUsuario" disabled>
            <i class="fas fa-plus"></i> Nuevo Usuario
          </button>
          <button class="btn btn-primary" id="btnImprimir">
            <i class="fas fa-print"></i> Imprimir
          </button>
        </div>
      </div>

      <div class="filters">
        <div class="filter-group">
          <label class="filter-label">Usuario:</label>
          <input type="text" class="filter-input" id="usuarioFilter" placeholder="Filtrar por usuario...">
        </div>
        <div class="filter-group">
          <label class="filter-label">Nombre:</label>
          <input type="text" class="filter-input" id="nombreFilter" placeholder="Filtrar por nombre...">
        </div>
        <div class="filter-group">
          <label class="filter-label">Estado:</label>
          <select class="filter-select" id="estadoFilter">
            <option value="">Todos los estados</option>
            <option value="ACTIVO">Activo</option>
            <option value="INACTIVO">Inactivo</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label">2FA:</label>
          <select class="filter-select" id="tfaFilter">
            <option value="">Todos</option>
            <option value="SI">Sí</option>
            <option value="NO">No</option>
          </select>
        </div>
        <button class="btn btn-primary" id="btnAplicarFiltros">
          <i class="fas fa-filter"></i> Aplicar Filtros
        </button>
        <button class="btn btn-secondary" id="btnLimpiarFiltros">
          <i class="fas fa-times"></i> Limpiar
        </button>
      </div>

      <div class="table-container">
        <table class="bitacora-table" id="usuariosTable">
          <thead>
            <tr>
              <th>Usuario</th>
              <th>Nombre</th>
              <th>Estado</th>
              <th>2FA</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="tablaBody">
            <% if (users && users.length > 0) { %>
              <% users.forEach(u => { %>
                <tr class="fila-usuario" data-id="<%= u.ID_USUARIO %>" data-usuario="<%= u.USUARIO %>">
                  <td class="usuario"><%= u.USUARIO %></td>
                  <td class="nombre"><%= u.NOMBRE_USUARIO %></td>
                  <td class="estado-td">
                    <span class="<%= u.ESTADO === 'ACTIVO' ? 'estado-activo' : 'estado-inactivo' %>">
                      <%= u.ESTADO %>
                    </span>
                  </td>
                  <td class="tfa-td">
                    <% if (u.ACTIVO_2FA) { %>
                      <i class="fas fa-check"></i> Sí
                    <% } else { %>
                      <i class="fas fa-times"></i> No
                    <% } %>
                  </td>
                  <td class="acciones-td">
                    <button class="btn-accion btn-editar" title="Editar usuario" data-id="<%= u.ID_USUARIO %>">
                      <i class="fas fa-edit"></i> Editar
                    </button>
                    <% if (u.ESTADO === 'ACTIVO') { %>
                      <button class="btn-accion btn-eliminar" title="Desactivar usuario" data-id="<%= u.ID_USUARIO %>">
                        <i class="fas fa-user-slash"></i> Desactivar
                      </button>
                    <% } else { %>
                      <button class="btn-accion btn-activar" title="Activar usuario" data-id="<%= u.ID_USUARIO %>">
                        <i class="fas fa-user-check"></i> Activar
                      </button>
                    <% } %>
                    <button class="btn-accion btn-eliminar-permanente" title="Eliminar usuario" data-id="<%= u.ID_USUARIO %>">
                      <i class="fas fa-trash"></i> Eliminar
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="no-results no-results-message">
                  No se encontraron usuarios en la base de datos.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="filters" style="justify-content: space-between;">
        <div><strong>Total de usuarios:</strong> <span id="totalUsuarios">0</span></div>
        <div><strong>Usuarios mostrados:</strong> <span id="usuariosMostrados">0</span></div>
        <div><strong>Última actualización:</strong> <span id="ultimaActualizacion"></span></div>
      </div>
    </div>

    <div class="footer">
      Clínicas Roca Maya - Sistema de Gestión &copy; 2025
    </div>
  </div>

  <!-- Modal para editar usuario -->
  <div id="modalUsuario" class="modal">
    <div class="modal-content">
      <h2 id="modalTitulo">Editar Usuario</h2>
      <form id="formUsuario">
        <input type="hidden" id="inputId">
        <div class="form-group">
          <label class="form-label">Usuario:</label>
          <input type="text" class="form-input" id="inputUsuario" required>
        </div>
        <div class="form-group">
          <label class="form-label">Nombre:</label>
          <input type="text" class="form-input" id="inputNombre" required>
        </div>
        <div class="form-group">
          <label class="form-label">Estado:</label>
          <select class="form-input" id="selectEstado" required>
            <option value="ACTIVO">Activo</option>
            <option value="INACTIVO">Inactivo</option>
          </select>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary btn-cancelar" id="btnCancelar">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btnGuardar">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal para eliminar usuario -->
  <div id="modalEliminar" class="modal">
    <div class="modal-content">
      <h2>Confirmar Eliminación</h2>
      <p id="textoConfirmacion">¿Está seguro de que desea eliminar al usuario?</p>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" id="btnCancelarEliminar">Cancelar</button>
        <button type="button" class="btn btn-eliminar-permanente" id="btnConfirmarEliminar">Eliminar</button>
      </div>
    </div>
  </div>

  <!-- Loading para generación de PDF -->
  <div class="loading" id="loading">
    <div style="background: white; padding: 20px; border-radius: 10px; color: #333;">
      <i class="fas fa-spinner fa-spin"></i> Generando PDF...
    </div>
  </div>
  <script src="/js/users.js" defer></script>
</body>
</html>