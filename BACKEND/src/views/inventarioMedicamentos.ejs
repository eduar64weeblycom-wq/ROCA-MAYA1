<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" href="/ICONO.jpg" type="image/jpeg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --accent-color: #e74c3c;
            --light-color: #ecf0f1;
            --dark-color: #0f2134;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #abd0f6;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .navbar-custom {
            background-color: var(--primary-color);
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
            padding: 10px 0;
        }

        .logo-btn {
            cursor: pointer;
            transition: transform 0.3s ease;
            height: 60px;
            width: auto;
        }

        .logo-btn:hover {
            transform: scale(1.05);
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border: none;
            margin-bottom: 20px;
        }

        .card-header {
            background-color: var(--primary-color);
            color: white;
            border-radius: 10px 10px 0 0 !important;
            font-weight: 600;
        }

        .badge-status {
            font-size: 0.8rem;
            padding: 5px 10px;
            border-radius: 20px;
        }

        .btn-primary {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
        }

        .btn-primary:hover {
            background-color: #2980b9;
            border-color: #2980b9;
        }

        .section-title {
            color: var(--primary-color);
            border-bottom: 2px solid var(--secondary-color);
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .modal-header {
            background-color: var(--primary-color);
            color: white;
        }

        .alert-notification {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            min-width: 300px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .table-hover tbody tr:hover {
            background-color: rgba(52, 152, 219, 0.1);
        }

        .search-box {
            border-radius: 25px;
            padding: 10px 20px;
            border: 2px solid var(--secondary-color);
        }

        .stats-card {
            text-align: center;
            padding: 20px;
            transition: transform 0.2s ease;
        }

        .stats-card:hover {
            transform: translateY(-5px);
        }

        .stats-number {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--primary-color);
        }

        .stats-label {
            color: #666;
            font-size: 1rem;
            font-weight: 500;
        }

        .clinic-title {
            color: white;
            font-weight: bold;
            font-size: 1.8rem;
            margin: 0;
        }

        .navbar-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .btn-action {
            margin: 0 2px;
        }

        .stock-bajo {
            background-color: #fff3cd !important;
        }

        .vencimiento-proximo {
            background-color: #f8d7da !important;
        }

        .filtro-activo {
            display: table-row;
        }

        .filtro-oculto {
            display: none;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container-fluid">
            <div class="navbar-content">
                <!-- Logo y Título -->
                <div class="d-flex align-items-center">
                    <a class="navbar-brand me-3" href="/dashboard">
                        <img src="/roca-maya-oct.jpg" alt="Dashboard" class="logo-btn" title="Ir al Dashboard">
                    </a>
                    <span class="clinic-title">Clínicas Médicas Roca Maya</span>
                </div>
                
                <div class="d-flex align-items-center gap-3">
    <!-- Botón nuevo medicamento -->
    <button class="btn btn-primary btn-lg" id="btnNuevoMedicamento">
        <i class="fas fa-plus me-2"></i> Nuevo Medicamento
    </button>
    
    <!-- Botón imprimir reporte -->
    <button id="btnImprimir" class="btn btn-secondary btn-lg">
        <i class="fas fa-print me-1"></i> Imprimir Reporte
    </button>
</div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container-fluid mt-4">
        <!-- Stats Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card stats-card border-primary">
                    <div class="stats-number" id="totalMedicamentos"><%= estadisticas.totalMedicamentos || 0 %></div>
                    <div class="stats-label">Total Medicamentos</div>
                    <small class="text-muted">Registrados en sistema</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stats-card border-warning">
                    <div class="stats-number text-warning" id="stockBajo"><%= estadisticas.stockBajo || 0 %></div>
                    <div class="stats-label">Stock Bajo</div>
                    <small class="text-muted">Por debajo del mínimo</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stats-card border-danger">
                    <div class="stats-number text-danger" id="proximoVencer"><%= estadisticas.proximoVencer || 0 %></div>
                    <div class="stats-label">Próximo a Vencer</div>
                    <small class="text-muted">30 días o menos</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stats-card border-success">
                    <div class="stats-number text-success" id="activos"><%= estadisticas.activos || 0 %></div>
                    <div class="stats-label">Activos</div>
                    <small class="text-muted">Disponibles para uso</small>
                </div>
            </div>
        </div>

        <!-- Search and Filters -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control search-box" id="searchInput" placeholder="Buscar por nombre comercial o genérico...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="filterEstado">
                            <option value="">Todos los estados</option>
                            <option value="ACTIVO">Activo</option>
                            <option value="INACTIVO">Inactivo</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="filterStock">
                            <option value="">Todo el stock</option>
                            <option value="BAJO">Stock Bajo</option>
                            <option value="OPTIMO">Stock Óptimo</option>
                            <option value="SIN_STOCK">Sin Stock</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medicamentos Table -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-capsule me-2"></i>Lista de Medicamentos
                </div>
                <div class="text-muted small">
                    Total: <span id="contadorMedicamentos"><%= medicamentos.length || 0 %></span> registros
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-striped" id="tablaMedicamentos">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre Comercial</th>
                                <th>Genérico</th>
                                <th>Presentación</th>
                                <th>Stock</th>
                                <th>Precio Venta</th>
                                <th>Vencimiento</th>
                                <th>Estado</th>
                                <th width="150">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyMedicamentos">
                            <% if (medicamentos && medicamentos.length > 0) { %>
                                <% medicamentos.forEach(med => { %>
                                    <%
                                        const hoy = new Date();
                                        const vencimiento = med.FECHA_VENCIMIENTO ? new Date(med.FECHA_VENCIMIENTO) : null;
                                        let diffDays = null;
                                        let claseFila = '';
                                        let infoVencimiento = '';

                                        if (vencimiento) {
                                            const diffTime = vencimiento - hoy;
                                            diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                                            
                                            if (diffDays <= 30 && diffDays >= 0) {
                                                claseFila = 'vencimiento-proximo';
                                                infoVencimiento = `<br><small class="text-danger">Vence en ${diffDays} días</small>`;
                                            }
                                        }

                                        if (med.STOCK_ACTUAL <= med.STOCK_MINIMO && med.ESTADO === 'ACTIVO') {
                                            claseFila = claseFila ? claseFila + ' stock-bajo' : 'stock-bajo';
                                        }

                                        const precioVenta = med.PRECIO_VENTA ? parseFloat(med.PRECIO_VENTA).toFixed(2) : '0.00';
                                    %>
                                    <tr class="<%= claseFila %> filtro-activo" data-id="<%= med.ID_MEDICAMENTO %>">
                                        <td><strong><%= med.NOMBRE_MEDICAMENTO %></strong></td>
                                        <td><%= med.NOMBRE_GENERICO || '-' %></td>
                                        <td><%= med.PRESENTACION || '-' %></td>
                                        <td>
                                            <span class="badge <%= med.STOCK_ACTUAL <= med.STOCK_MINIMO ? 'bg-warning' : 'bg-success' %>">
                                                <%= med.STOCK_ACTUAL %>
                                            </span>
                                            <% if (med.STOCK_MINIMO) { %>
                                                <small class="text-muted">/ min <%= med.STOCK_MINIMO %></small>
                                            <% } %>
                                        </td>
                                        <td><strong>$<%= precioVenta %></strong></td>
                                        <td>
                                            <%= med.FECHA_VENCIMIENTO || '-' %>
                                            <%- infoVencimiento %>
                                        </td>
                                        <td>
                                            <span class="badge <%= med.ESTADO === 'ACTIVO' ? 'bg-success' : 'bg-secondary' %>">
                                                <%= med.ESTADO %>
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary btn-action btn-editar" 
                                                    data-id="<%= med.ID_MEDICAMENTO %>" 
                                                    title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning btn-action btn-ajustar-stock" 
                                                    data-id="<%= med.ID_MEDICAMENTO %>" 
                                                    data-nombre="<%= med.NOMBRE_MEDICAMENTO %>" 
                                                    data-stock="<%= med.STOCK_ACTUAL %>" 
                                                    title="Ajustar Stock">
                                                <i class="fas fa-boxes"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger btn-action btn-eliminar" 
                                                    data-id="<%= med.ID_MEDICAMENTO %>" 
                                                    title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">
                                        <i class="fas fa-inbox fa-2x mb-3"></i><br>
                                        No se encontraron medicamentos<br>
                                        <small class="text-muted">Haz clic en "Nuevo Medicamento" para agregar uno</small>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para agregar/editar medicamento -->
    <div class="modal fade" id="modalMedicamento" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Nuevo Medicamento</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="formMedicamento">
                        <input type="hidden" id="idMedicamento">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Nombre Comercial *</label>
                                    <input type="text" class="form-control" id="nombreMedicamento" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Nombre Genérico</label>
                                    <input type="text" class="form-control" id="nombreGenerico">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Presentación</label>
                                    <input type="text" class="form-control" id="presentacion" placeholder="Tabletas, Jarabe, etc.">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Stock Actual</label>
                                            <input type="number" class="form-control" id="stockActual" value="0" min="0">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Stock Mínimo</label>
                                            <input type="number" class="form-control" id="stockMinimo" value="10" min="0">
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Precio Venta</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" step="0.01" class="form-control" id="precioVenta" min="0" placeholder="0.00">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Fecha Vencimiento</label>
                                    <input type="date" class="form-control" id="fechaVencimiento">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Estado</label>
                                    <select class="form-select" id="estado">
                                        <option value="ACTIVO">Activo</option>
                                        <option value="INACTIVO">Inactivo</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnGuardarMedicamento">
                        <i class="fas fa-save me-2"></i>Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para ajustar stock -->
    <div class="modal fade" id="modalStock" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ajustar Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="idMedicamentoStock">
                    <div class="mb-3">
                        <label class="form-label">Medicamento</label>
                        <input type="text" class="form-control" id="nombreMedicamentoStock" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Stock Actual</label>
                        <input type="number" class="form-control" id="stockActualDisplay" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Acción</label>
                        <select class="form-select" id="accionStock">
                            <option value="agregar">Agregar Stock</option>
                            <option value="quitar">Quitar Stock</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cantidad</label>
                        <input type="number" class="form-control" id="cantidadStock" min="1" value="1">
                    </div>
                    <div class="alert alert-info">
                        <small>
                            <i class="fas fa-info-circle me-2"></i>
                            <span id="infoStock"></span>
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnAjustarStock">
                        <i class="fas fa-check me-2"></i>Aplicar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Pasar datos del servidor al cliente
        window.medicamentosData = <%- JSON.stringify(medicamentos) %>;
        window.estadisticasData = <%- JSON.stringify(estadisticas) %>;
        window.API_BASE = '/inventario';
    </script>
    <script src="/js/medicamentos.js"></script>
</body>
</html>